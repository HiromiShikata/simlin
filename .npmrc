engine-strict=true
auto-install-peers=true
strict-peer-dependencies=true
min-release-age=7 # 7 days: minimum time a package must be published before it can be installed (supply-chain attack mitigation)
ignore-scripts=true # trade-off: disables lifecycle scripts (mitigates malicious install scripts), but may require a separate `playwright install` step for browser binary downloads
save-exact=true
package-lock=true
