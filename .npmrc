engine-strict=true
auto-install-peers=true
strict-peer-dependencies=true
# 7 days: minimum time a package must be published before it can be installed (supply-chain attack mitigation)
min-release-age=7
# trade-off: disables lifecycle scripts (mitigates malicious install scripts), but may require a separate `playwright install` step for browser binary downloads
ignore-scripts=true
save-exact=true
package-lock=true
